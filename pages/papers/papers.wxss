/* pages/papers/papers.wxss —— 真题练习页样式 */

.intro {
  margin-bottom: 22rpx;
  padding: 8rpx 4rpx;
}

.intro-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.2rpx;
  margin-bottom: 8rpx;
}

.intro-sub {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

/* ---- 套卷卡片 ---- */
.paper {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.paper-open {
  border-color: rgba(255, 107, 53, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.06);
}

.paper-head {
  display: flex;
  align-items: center;
  cursor: pointer;
}

.paper-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
}

.paper-meta {
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 16rpx;
  border-right: 2.5rpx solid var(--muted);
  border-bottom: 2.5rpx solid var(--muted);
  transform: rotate(45deg);
  transition: transform 0.2s ease;
  margin-bottom: 4rpx;
}

.arrow-open {
  transform: rotate(-135deg);
  border-color: var(--cinnabar);
}

.note {
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.6;
  margin: 16rpx 0 6rpx;
  padding: 12rpx 18rpx;
  background-color: var(--line-light);
  border-left: 4rpx solid var(--cinnabar);
  border-radius: 0 8rpx 8rpx 0;
}

/* ---- 题目展开 ---- */
.q {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line-light);
}

.q-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.q-no {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--cinnabar);
  margin-right: 14rpx;
}

.q-type {
  font-size: 21rpx;
  font-weight: 500;
  color: var(--gold);
  background-color: var(--gold-soft);
  border-radius: var(--radius-pill);
  padding: 2rpx 12rpx;
}

.q-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.sub-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--sub);
  margin: 12rpx 0 8rpx;
}

.q-material {
  font-size: 26rpx;
  color: var(--ink-sub);
  line-height: 1.75;
  padding: 16rpx 20rpx;
  background-color: #F8F9FA;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}

.keys {
  display: flex;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.key {
  font-size: 22rpx;
  color: var(--cinnabar-deep);
  line-height: 1.4;
  padding: 6rpx 16rpx;
  margin: 0 10rpx 10rpx 0;
  border-radius: var(--radius-pill);
  background-color: var(--cinnabar-soft);
}

.q-btn {
  margin: 18rpx 0 0;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 14rpx;
}
/* Collected library and offline examples share the native design system. */
.library-tabs { display: flex; padding: 6rpx; background: #ECEEF2; border-radius: 16rpx; margin-bottom: 24rpx; }
.library-tab { flex: 1; padding: 22rpx 8rpx; text-align: center; color: var(--sub); border-radius: 12rpx; }
.library-tab-active { background: var(--card); color: var(--cinnabar-deep); font-weight: 600; }
.library-filter-row { display: flex; margin: 20rpx 0; }
.library-picker { flex: 1; border: 1rpx solid var(--line); padding: 20rpx 14rpx; border-radius: 12rpx; font-size: 26rpx; }
.library-picker + .library-picker { margin-left: 20rpx; }
.library-login { margin-top: 20rpx; }
.library-recalled { margin-top: 12rpx; color: var(--cinnabar-deep); font-size: 24rpx; }
.library-status { padding: 32rpx 0; color: var(--sub); }
.library-error { margin-top: 24rpx; padding: 20rpx; color: #B91C1C; background: #FEF2F2; border-radius: 12rpx; word-break: break-all; }
.library-error button { margin-top: 20rpx; }
.library-source { margin: 20rpx 0; font-size: 24rpx; color: var(--sub); word-break: break-all; }
.library-source .link { display: block; padding: 18rpx 0; }
.library-material { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.library-material-head { font-weight: 600; margin-bottom: 14rpx; }
.library-text { display: block; font-size: 28rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-all; }
.library-expand { padding: 22rpx 0; color: var(--cinnabar-deep); font-size: 26rpx; }
.library-requirements { margin-top: 14rpx; font-size: 26rpx; line-height: 1.7; color: var(--sub); }
