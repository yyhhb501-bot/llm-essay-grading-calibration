/* pages/index/index.wxss —— 首页样式 */

/* ---- 品牌区 ---- */
.brand {
  padding: 16rpx 4rpx 24rpx;
}

.brand-header-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-badge {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #FF7842 0%, #FF5A1F 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 53, 0.25);
}

.brand-badge-text {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand-title-wrap {
  flex: 1;
}

.brand-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.5rpx;
  line-height: 1.25;
}

.brand-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--sub);
  line-height: 1.4;
}

/* ---- 核心主行动卡片 ---- */
.hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFDFB 100%);
  border: 1.5rpx solid rgba(255, 107, 53, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.08);
  margin-bottom: 24rpx;
}

.hero-left {
  flex: 1;
  padding-right: 20rpx;
}

.hero-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--cinnabar);
  background-color: var(--cinnabar-soft);
  padding: 3rpx 12rpx;
  border-radius: var(--radius-pill);
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.hero-desc {
  font-size: 23rpx;
  color: var(--sub);
  margin-top: 8rpx;
  line-height: 1.4;
}

.hero-btn {
  width: 170rpx;
  height: 76rpx;
  font-size: 28rpx;
  margin: 0;
  flex-shrink: 0;
  border-radius: 14rpx;
}

/* ---- 分区标题 ---- */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--sub);
  margin: 10rpx 4rpx 16rpx;
  letter-spacing: 0.5rpx;
}

/* ---- 四宫格入口 ---- */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.grid-item {
  width: 336rpx;
  margin-bottom: 18rpx;
  padding: 24rpx 22rpx;
  transition: all 0.15s ease;
  display: flex;
  flex-direction: column;
}

.grid-item:active {
  background-color: #F8F9FA;
  transform: translateY(1rpx);
}

.grid-icon-wrap {
  margin-bottom: 14rpx;
}

.grid-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  background-color: var(--line-light);
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.grid-item:active .grid-icon {
  background-color: var(--cinnabar-soft);
  color: var(--cinnabar);
}

.grid-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
}

.grid-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
}

/* ---- 每日金句卡片 ---- */
.quote-card {
  padding: 22rpx 26rpx;
  margin-bottom: 20rpx;
  background-color: #FAFBFC;
}

.quote-header {
  margin-bottom: 10rpx;
}

.quote-tag {
  font-size: 21rpx;
  font-weight: 600;
  color: var(--sub);
  background-color: var(--line-light);
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
}

.quote-content {
  font-size: 27rpx;
  color: var(--ink-sub);
  line-height: 1.7;
}

/* ---- 最近记录 ---- */
.recent-card {
  padding: 24rpx 26rpx;
}

.recent-title {
  margin-bottom: 0;
}

.recent-more {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.list-arrow {
  width: 13rpx;
  height: 13rpx;
  border-top: 2.5rpx solid var(--muted);
  border-right: 2.5rpx solid var(--muted);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.recent-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-light);
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-head {
  align-items: flex-start;
}

.recent-title-text {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  padding-right: 14rpx;
}

.recent-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--cinnabar);
  padding: 3rpx 12rpx;
  border-radius: var(--radius-pill);
  background-color: var(--cinnabar-soft);
}

.recent-summary {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--sub);
  line-height: 1.6;
}

.recent-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.recent-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 12rpx;
}

.recent-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
  text-align: center;
}

.recent-empty-text {
  font-size: 27rpx;
  color: var(--sub);
  margin-bottom: 24rpx;
}

.recent-empty-btn {
  width: 280rpx;
  height: 80rpx;
  font-size: 29rpx;
  margin: 0 auto;
}