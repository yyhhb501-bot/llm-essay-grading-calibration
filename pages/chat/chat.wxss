/* pages/chat/chat.wxss —— 解题陪练聊天页样式 */

.chat-page {
  min-height: 100vh;
  background-color: var(--paper);
}

/* 顶部标题栏与快捷指令 */
.chat-head {
  background-color: var(--card);
  border-bottom: 1rpx solid var(--line);
  padding: 20rpx 28rpx 16rpx;
}

.chat-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-head-left {
  display: flex;
  align-items: baseline;
}

.chat-head-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.2rpx;
}

.chat-head-sub {
  font-size: 23rpx;
  color: var(--muted);
  margin-left: 14rpx;
}

.btn-mini {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--cinnabar-border);
  color: var(--cinnabar);
  background-color: var(--cinnabar-soft);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}

.btn-mini:active {
  background-color: #FFE6D9;
}

.chips-bar {
  white-space: nowrap;
  margin-top: 16rpx;
}

.chips-bar .chip {
  margin-bottom: 0;
  margin-right: 12rpx;
}

/* 只读提示条 */
.readonly-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--gold-soft);
  border-bottom: 1rpx solid rgba(255, 125, 0, 0.2);
  padding: 12rpx 28rpx;
}

.readonly-text {
  font-size: 24rpx;
  color: var(--gold);
}

.readonly-btn {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--gold);
  color: var(--gold);
  font-size: 23rpx;
}

/* 消息流 */
.msg-scroll {
  height: calc(100vh - 180rpx - 170rpx - env(safe-area-inset-bottom));
  padding: 0 28rpx;
}

.msg-scroll-full {
  height: calc(100vh - 180rpx - env(safe-area-inset-bottom));
}

.msg-list {
  padding: 24rpx 0;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.row-user {
  justify-content: flex-end;
}

.row-ai {
  justify-content: flex-start;
}

/* 气泡公共基底 */
.bubble {
  max-width: 86%;
  box-sizing: border-box;
  word-break: break-word;
}

/* 用户气泡 */
.bubble-user {
  max-width: 80%;
  background-color: var(--cinnabar-soft);
  border: 1rpx solid rgba(255, 107, 53, 0.22);
  border-radius: 18rpx 18rpx 4rpx 18rpx;
  padding: 18rpx 22rpx 10rpx;
}

.bubble-user-text {
  display: block;
  font-size: 29rpx;
  color: var(--ink);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

/* AI 气泡 */
.bubble-ai {
  max-width: 88%;
  background-color: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 18rpx 18rpx 18rpx 4rpx;
  box-shadow: var(--shadow);
  padding: 20rpx 24rpx 10rpx;
}

.ai-name {
  display: block;
  font-size: 22rpx;
  color: var(--cinnabar);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.bubble-ai .md-h2 {
  margin-top: 20rpx;
}

.bubble-ai .md-p,
.bubble-ai .md-li {
  font-size: 28.5rpx;
}

.bubble-time {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 10rpx;
  text-align: right;
}

/* 打字光标 */
.typing-caret {
  display: inline-block;
  width: 5rpx;
  height: 28rpx;
  background-color: var(--cinnabar);
  margin: 10rpx 4rpx 0 0;
  animation: caret-blink 1s steps(1, end) infinite;
}

@keyframes caret-blink {
  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}

/* 打字指示 */
.typing-tip {
  display: flex;
  align-items: center;
  padding: 6rpx 8rpx 20rpx;
}

.typing-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: var(--cinnabar);
  margin-right: 8rpx;
  animation: dot-blink 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.typing-text {
  font-size: 23rpx;
  color: var(--muted);
  margin-left: 8rpx;
}

@keyframes dot-blink {
  0%, 80%, 100% { opacity: 0.25; }
  40% { opacity: 1; }
}

/* 错误卡 */
.error-card {
  background-color: var(--danger-soft);
  border: 1rpx solid var(--danger);
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
}

.error-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--danger);
  margin-bottom: 6rpx;
}

.error-text {
  font-size: 25rpx;
  color: var(--ink);
  line-height: 1.6;
}

.error-actions {
  display: flex;
  margin-top: 16rpx;
}

.error-btn {
  padding: 10rpx 24rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--cinnabar);
  color: var(--cinnabar);
  font-size: 24rpx;
  margin-right: 14rpx;
}

.error-btn-primary {
  background-color: var(--cinnabar);
  color: #FFFFFF;
}

/* 空态 */
.empty-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 25rpx;
  color: var(--muted);
}

.msg-bottom {
  height: 8rpx;
}

/* 底部输入栏 */
.chat-dock {
  height: 170rpx;
  padding: 14rpx 28rpx;
}

.dock-row {
  display: flex;
  align-items: flex-end;
  height: 100rpx;
}

.dock-input {
  flex: 1;
  min-height: 68rpx;
  max-height: 100rpx;
  background-color: #F8F9FA;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
}

.dock-placeholder {
  color: var(--muted);
  font-size: 25rpx;
}

.send-btn {
  flex: none;
  margin-left: 14rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  background-color: var(--cinnabar);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.15s ease;
}

.send-btn-off {
  background-color: #E5E7EB;
  color: #9CA3AF;
}

.dock-hint {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 10rpx;
}
