<!-- pages/grade/grade.wxml —— 智能批改页 -->
<view class="page">

  <!-- 未配置模型时的引导 -->
  <view wx:if="{{!configured}}" class="card tip-card">
    <view class="card-title no-margin">登录账号或配置模型</view>
    <view class="tip-desc">登录后可使用站点共享模型；也可填写自己的 API Key。历史与计划在本机保存，各账号分别管理。</view>
    <button class="btn-primary tip-btn" bindtap="onGoAccount">登录 / 注册</button>
    <button class="btn-ghost tip-btn" bindtap="goSettings">配置自己的模型</button>
  </view>

  <!-- 真题预填来源 -->
  <view wx:if="{{paperTitle}}" class="card preset-card">
    <view class="row-between">
      <view class="preset-tag">{{paperSourceLabel}}</view>
    </view>
    <view class="preset-title">{{paperTitle}}</view>
    <text class="field-hint">{{paperSourceNote}}</text>
  </view>

  <!-- 题目与题型 -->
  <view class="card">
    <view class="card-title">题目与要求</view>

    <view class="field">
      <view class="field-label">
        <text>题型</text>
      </view>
      <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange" disabled="{{submitting}}">
        <view class="picker-box">
          <text class="picker-value">{{typeOptions[typeIndex]}}</text>
          <text class="picker-arrow">切换 ▾</text>
        </view>
      </picker>
    </view>

    <view class="field mb-0">
      <view class="field-label">
        <text>作答要求</text>
        <text class="tag-badge tag-required">必填</text>
      </view>
      <textarea class="input-box ta ta-question"
                value="{{question}}"
                bindinput="onQuestionInput"
                disabled="{{submitting}}"
                maxlength="-1"
                show-confirm-bar="{{false}}"
                placeholder="粘贴作答要求：任务类型、作答对象、字数限制、身份与格式限定" />
    </view>
  </view>

  <!-- 给定资料 -->
  <view class="card">
    <view class="field mb-0">
      <view class="field-label">
        <text>给定资料</text>
        <text class="tag-badge tag-optional">选填·强烈建议</text>
      </view>
      <textarea class="input-box ta ta-material"
                value="{{material}}"
                bindinput="onMaterialInput"
                disabled="{{submitting}}"
                maxlength="-1"
                show-confirm-bar="{{false}}"
                placeholder="粘贴材料原文；材料越完整，采分点比对越精准" />
      <text class="field-hint">请提供本题对应资料；缺少关键材料时只做常识与表达诊断，暂无法核验踩分点。</text>
    </view>
  </view>

  <!-- 参考答案 -->
  <view class="card">
    <view class="field mb-0">
      <view class="field-label">
        <text>参考答案</text>
        <text class="tag-badge tag-optional">选填</text>
      </view>
      <textarea class="input-box ta ta-reference"
                value="{{referenceAnswer}}"
                bindinput="onReferenceInput"
                disabled="{{submitting}}"
                maxlength="-1"
                show-confirm-bar="{{false}}"
                placeholder="粘贴官方或机构参考答案，供比对采分点覆盖率" />
      <text class="field-hint">参考答案用于比对要点覆盖率，不能替代给定资料依据。</text>
    </view>
  </view>

  <!-- 我的作答 -->
  <view class="card">
    <view class="row-between answer-head">
      <view class="card-title no-margin">
        <text>我的作答</text>
        <text class="tag-badge tag-required ml-s">必填</text>
      </view>
      <button class="photo-btn" bindtap="onScanAnswer" disabled="{{submitting}}">
        {{scanning ? '点击取消' : '📷 拍照识别'}}
      </button>
    </view>

    <view wx:if="{{scanStatus}}" class="field-hint scan-status">{{scanStatus}}</view>
    <view wx:if="{{scanError}}" class="scan-err-box">
      <view class="scan-err-title">识别提示</view>
      <view class="quote-red scan-msg">{{scanError}}</view>
    </view>

    <view class="field mb-0">
      <textarea class="input-box ta ta-answer"
                value="{{answer}}"
                bindinput="onAnswerInput"
                disabled="{{submitting}}"
                maxlength="-1"
                show-confirm-bar="{{false}}"
                placeholder="在此输入你的作答原文，尽量保持原有分段与小标序号" />
      <view class="row-between count-row">
        <text class="field-hint length-hint">{{lengthHint}}</text>
        <view class="count-badge">
          <text class="count-num">{{answerWords}}</text>
          <text class="count-unit">字</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部主提交区 -->
  <view class="submit-wrap">
    <button class="btn-primary btn-submit" bindtap="onStart" disabled="{{submitting}}">
      {{submitting ? '正在深度批改中…' : '开始智能批改'}}
    </button>
    <view class="muted foot-note">批改结论由 AI 生成，仅供参考，正式成绩以官方评分为准；API Key 仅保存在本机。</view>
  </view>

  <view class="safe-bottom"></view>
</view>
<privacy-dialog id="privacy-dialog" />
