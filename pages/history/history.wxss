/* pages/history/history.wxss —— 历史记录页 */

.filter-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  background-color: var(--card);
  border: 1rpx solid var(--line);
  color: var(--sub);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.3;
  transition: all 0.2s ease;
}

.filter-active {
  background-color: var(--cinnabar-soft);
  border-color: var(--cinnabar-border);
  color: var(--cinnabar);
  font-weight: 600;
}

.total {
  color: var(--muted);
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
}

.total:active {
  color: var(--danger);
  background-color: var(--danger-soft);
}

/* ---- 列表项 ---- */
.item {
  padding: 28rpx 28rpx;
  margin-bottom: 20rpx;
  transition: background-color 0.15s ease;
  position: relative;
}

.item:active {
  background-color: #F8F9FA;
}

.item-grade {
  border-left: 8rpx solid var(--cinnabar);
}

.item-chat {
  border-left: 8rpx solid var(--gold);
}

.head {
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.5;
  padding-right: 16rpx;
}

.history-score-badge {
  font-family: "DIN Alternate", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-weight: 700;
  font-size: 26rpx;
  color: var(--cinnabar);
  background-color: var(--cinnabar-soft);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  border: 1rpx solid var(--cinnabar-border);
  letter-spacing: 0.5rpx;
}

.tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--sub);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background-color: var(--line-light);
}

.summary {
  font-size: 26rpx;
  color: var(--sub);
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.foot {
  border-top: 1rpx solid var(--line-light);
  padding-top: 16rpx;
}

.time,
.rel {
  font-size: 24rpx;
  color: var(--muted);
}

.tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

/* ---- 空态 ---- */
.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  background-color: var(--card);
  border-radius: var(--radius);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
  margin-top: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  color: var(--ink);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 36rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
}

.empty-btn {
  width: 320rpx;
  margin-bottom: 0;
}